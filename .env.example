# Copy to .env (gitignored) and fill in, then `docker compose --env-file .env up --build`
# or export these in your shell before `docker compose up`.

# --- Email OTP delivery (auth-service) ---
# Gmail SMTP + an App Password (see backend/README.md for how to obtain one).
# Any other SMTP provider (SendGrid, Mailgun, SES) works too — just change these.
RISKYC_MAIL_HOST=smtp.gmail.com
RISKYC_MAIL_PORT=587
RISKYC_MAIL_USERNAME=your-address@gmail.com
RISKYC_MAIL_PASSWORD=your-16-character-app-password
RISKYC_MAIL_FROM=your-address@gmail.com

# --- Media (media-service) ---
# media-service issues MinIO pre-signed URLs using this as the host part —
# it MUST be reachable from wherever the client (phone) actually is, not
# just from inside the docker network. Left at localhost, every image/voice
# message/video URL would 404 on any device other than the host machine
# itself. On the VPS this needs to be the public IP/domain, port 9000
# (docker-compose already publishes that port).
RISKYC_MINIO_PUBLIC_ENDPOINT=http://167.86.120.214:9000

# --- Host port overrides ---
# Only needed if one of these already collides with another stack running
# on the same host (docker will refuse to start the container and say
# "address already in use" — it won't silently conflict). Uncomment and
# change whichever one clashes; everything else can stay at its default.
# If you change MINIO_API_HOST_PORT, update RISKYC_MINIO_PUBLIC_ENDPOINT's
# port above to match, since that's what the mobile client actually uses.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# AUTH_SERVICE_HOST_PORT=8081
# MESSAGING_SERVICE_HOST_PORT=8082
# MEDIA_SERVICE_HOST_PORT=8083
# PRESENCE_SERVICE_HOST_PORT=8084
